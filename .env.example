# ---------------------------------------------------------------------------
# Ludo Neon backend configuration
# Copy this file to `.env` (never commit `.env`) and adjust if needed.
# The server reads these with `process.env.*`; no dotenv package is required
# when you export them in your shell or your host's dashboard.
# ---------------------------------------------------------------------------

# Port the Node/Socket.IO server listens on.
PORT=3000

# Interface to bind. 0.0.0.0 makes it reachable from other devices on the LAN.
HOST=0.0.0.0

# Comma-separated list of allowed browser origins, or * for development.
# Production example:
#   CORS_ORIGIN=https://your-user.github.io,https://ludo.example.com
CORS_ORIGIN=*

# Serve the static frontend from this same Node process (true) or host the
# frontend separately / on GitHub Pages (false).
SERVE_STATIC=true

# Room / session limits (optional, sensible defaults shown).
MAX_ROOMS=500
RECONNECT_TTL_MS=600000
EMPTY_ROOM_TTL_MS=300000
IDLE_ROOM_TTL_MS=7200000

# How long a disconnected player keeps their seat during a live match before
# the server forfeits on their behalf (milliseconds).
FORFEIT_AFTER_MS=300000

# Public URL of this backend, used only in documentation/health output.
# PUBLIC_ORIGIN=https://ludo-neon-server.onrender.com
